{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/public/cron/notification-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/public/cron/peppol-retry",
      "schedule": "30 8 * * *"
    }
  ]
}
